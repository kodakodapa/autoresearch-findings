def U (g : List Nat) : Int := tensor ((g.map (fun v => 4 ^ cell v)).sum)
def rawRow (a b i : Nat) : Int := rsum 5 (fun j => if isMatch 5 [var 5 i j,a,b] then U [var 5 i j,a,b] else 0)
def rawCol (a b j : Nat) : Int := rsum 14 (fun i => if isMatch 5 [var 5 i j,a,b] then U [var 5 i j,a,b] else 0)
def Check (a b : Nat) : Prop := a ≠ b → isMatch 5 [a,b] = true →
 (∀ i : Fin 14, pfree 5 [a,b] i → (3 : Int) ∣ rawRow a b i + 1) ∧
 (∀ j : Fin 5, hfree 5 [a,b] j → (3 : Int) ∣ rawCol a b j + 1)
instance (a b : Nat) : Decidable (Check a b) := by unfold Check pfree hfree; infer_instance
theorem canon_U (g : List Nat) (hg : g.Nodup) (hb : ∀ v ∈ g, v < 70) :
    U (canon 70 g) = U g := by
  have hp : (canon 70 g).Perm g :=
    (List.perm_ext_iff_of_nodup (canon_nodup _ _) hg).mpr
      (fun v => by rw [mem_canon]; exact ⟨And.left, fun h => ⟨h, hb v h⟩⟩)
  unfold U
  rw [(hp.map (fun v => 4 ^ cell v)).sum_nat]

theorem raw_line (g : List Nat) (hg : CM 5 9 g) (v : Nat → Nat) (N : Nat)
    (hv : ∀ t < N, v t < 70) (hf : ∀ t < N, v t ∉ g) :
    lineS 5 9 U g v N = rsum N (fun t => if isMatch 5 (v t :: g) then U (v t :: g) else 0) := by
  unfold lineS
  apply rsum_congr
  intro t ht
  rw [canon_U _ (List.nodup_cons.mpr ⟨hf t ht, CM_nodup hg⟩)
    (fun x hx => by rcases List.mem_cons.mp hx with rfl | hx; exact hv t ht; exact CM_lt hg hx)]
