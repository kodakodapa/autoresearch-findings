/-! K35's design `B` (th) as a finite Lean object: `ontoFPHP 4 8` (12 pigeons, 4 holes), over `Z/2`.
`B` is the indicator of the union of the 21 seed orbits under the order-165 group, packed as a bitmask
indexed by the descending variable list (`idx`). Checked by kernel evaluation at every canonical
matching of size `e ≤ 2`. -/

namespace Programme.«20261026-1402-proof-complexity».BDes

open Programme.«20261025-0459-proof-complexity».OntoFPHP
open Programme.«20261025-1627-proof-complexity».MomGen
open Programme.«20261026-1402-proof-complexity».ExtLemma

def mask : Nat := 

def idxA : Nat → List Nat → Nat
  | a, [] => a
  | a, v :: l => idxA (a * 49 + v + 1) l

/-- K35's `B` (support: 2589 matchings of size at most 3). -/
def B (g : List Nat) : Int := if g.length ≤ 3 then ((mask >>> idxA 0 g) % 2 : Nat) else 0

def allL : Nat → List (List Nat)
  | 0 => [[]]
  | e + 1 => (List.range 48).flatMap fun a => (allL e).map (a :: ·)

def okG (g : List Nat) : Bool :=
  !(canon ((4 + 8) * 4) g == g && isMatch 4 g) ||
  (((List.range 12).all fun i => !(g.all fun v => v / 4 != i) || (rowS 4 8 B g i - B g) % 2 == 0) &&
   ((List.range 4).all fun j => !(g.all fun v => v % 4 != j) || (colS 4 8 B g j - B g) % 2 == 0))

def chk (e : Nat) : Bool := (allL e).all okG

theorem mem_allL : ∀ g : List Nat, (∀ v ∈ g, v < 48) → g ∈ allL g.length
  | [], _ => by simp [allL]
  | a :: l, h => by
    simp only [allL, List.length_cons, List.mem_flatMap, List.mem_range, List.mem_map]
    exact ⟨a, h a (by simp), l, mem_allL l (fun v hv => h v (by simp [hv])), rfl⟩

theorem bal_of_chk {e : Nat} (h : chk e = true) : Bal 2 4 8 B B e := by
  intro g hg hl
  have hlt : ∀ v ∈ g, v < 48 := by
    intro v hv
    have := hg.1 ▸ hv
    exact ((mem_canon _ _ _).1 this).2
  have hm := mem_allL g hlt
  rw [hl] at hm
  have hok := List.all_eq_true.1 h g hm
  have hc : (canon ((4 + 8) * 4) g == g && isMatch 4 g) = true := by
    simp [hg.1, hg.2]
  simp only [okG, hc, Bool.not_true, Bool.false_or, Bool.and_eq_true, List.all_eq_true,
    List.mem_range] at hok
  refine ⟨fun i hi hf => ?_, fun j hj hf => ?_⟩
  · have hb : (g.all fun v => v / 4 != i) = true := by
      simp only [List.all_eq_true, bne_iff_ne]; exact hf
    have := hok.1 i hi
    simp only [hb, Bool.not_true, Bool.false_or, beq_iff_eq] at this
    exact Int.dvd_of_emod_eq_zero this
  · have hb : (g.all fun v => v % 4 != j) = true := by
      simp only [List.all_eq_true, bne_iff_ne]; exact hf
    have := hok.2 j hj
    simp only [hb, Bool.not_true, Bool.false_or, beq_iff_eq] at this
    exact Int.dvd_of_emod_eq_zero this

theorem chk0 : chk 0 = true := by decide +kernel
theorem chk1 : chk 1 = true := by decide +kernel


/-- Level-2 slice: the lists `[a, b]`, `b < 48`. -/
def chkS (a : Nat) : Bool := ((List.range 48).map fun b => [a, b]).all okG

theorem chk2_of (h : ∀ a < 48, chkS a = true) : chk 2 = true := by
  simp only [chk, allL, List.all_flatMap, List.all_eq_true, List.mem_range] at *
  intro a ha
  have := h a ha
  simp only [chkS, List.all_map, List.all_eq_true, List.mem_range, Function.comp_def] at this
  intro x hx
  simp only [List.mem_map, List.mem_flatMap, List.mem_range, List.mem_singleton] at hx
  obtain ⟨y, ⟨b, hb, z, rfl, rfl⟩, rfl⟩ := hx
  exact this b hb

theorem B_nil : B [] = 1 := by decide +kernel

end Programme.«20261026-1402-proof-complexity».BDes
