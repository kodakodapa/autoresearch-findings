def gR (s : Nat) : Int := if 1 ≤ s then 1 else 0
def gT (s : Nat) : Int := if 2 ≤ s then 1 else 0
def g1 (_ : Nat) : Int := 1

/-! ## Block `B` (pigeons `< 12`, holes `< 4`) -/

theorem locL_congrQ (φ : List Nat → Int) (g : List Nat) (v : Nat → Nat) (M : Nat) (Q Q' : Nat → Prop)
    [DecidablePred Q] [DecidablePred Q'] (h : ∀ t < M, Q t ↔ Q' t) :
    locL 7 φ g v M Q = locL 7 φ g v M Q' := by
  unfold locL
  apply Programme.«20261025-0459-proof-complexity».OntoSubst.rsum_congr
  intro t ht
  by_cases hq : Q t
  · have hq' := (h t ht).mp hq; simp [hq, hq']
  · have hq' : ¬ Q' t := fun h' => hq ((h t ht).mpr h'); simp [hq, hq']

theorem b7_loc (m : Nat) (bp bh : Nat → Nat) (hm : 0 < m) (hbp : ∀ i, bp i = 0 ↔ i < 12)
    (hbh : ∀ j, bh j = 0 ↔ j < 4) : LocBal 2 m bp bh 7 8 Programme.«20261027-1434-proof-complexity».HDes.B7 0 2 := by
  intro g' hnd hmt hb hl
  have hσ : ∀ v ∈ g', Programme.«20261027-1434-proof-complexity».HDes.In0 v := by
    intro v hv
    have := blkM_eq (hb v hv).2 hm
    exact ⟨(hbp _).mp this.1, (hbh _).mp this.2⟩
  refine ⟨fun i hi hbi hf => ?_, fun j hj hbj hf => ?_⟩
  · have hi12 := (hbp i).mp hbi
    rw [locL_congrQ _ _ _ _ _ (fun t => Programme.«20261027-1434-proof-complexity».HDes.bh t = 0) (fun t _ => by
      rw [hbh]; unfold Programme.«20261027-1434-proof-complexity».HDes.bh; split <;> omega), Programme.«20261027-1434-proof-complexity».HDes.row0 hσ hi12]
    exact ((Programme.«20261026-1402-proof-complexity».BDesMain.b_design.2 _ (by omega))
      _ (Programme.«20261027-1434-proof-complexity».HDes.red_CM hσ hmt) (Programme.«20261027-1434-proof-complexity».HDes.red_len hσ hnd)).1 i (by omega) (Programme.«20261027-1434-proof-complexity».HDes.red_pfree hσ hf)
  · have hj4 := (hbh j).mp hbj
    rw [locL_congrQ _ _ _ _ _ (fun s => Programme.«20261027-1434-proof-complexity».HDes.bp s = 0) (fun t _ => by
      rw [hbp]; unfold Programme.«20261027-1434-proof-complexity».HDes.bp; split <;> omega), show (7 + 8 : Nat) = 15 from rfl,
      Programme.«20261027-1434-proof-complexity».HDes.col0 hσ hj4]
    exact ((Programme.«20261026-1402-proof-complexity».BDesMain.b_design.2 _ (by omega))
      _ (Programme.«20261027-1434-proof-complexity».HDes.red_CM hσ hmt) (Programme.«20261027-1434-proof-complexity».HDes.red_len hσ hnd)).2 j hj4 (Programme.«20261027-1434-proof-complexity».HDes.red_hfree hσ hf)

/-! ## The local degree-2 design `M` on pigeons `4..14` × holes `4..6` -/

def MS1 : List Nat := [32, 39, 46, 53, 60, 68, 75, 82, 89, 96, 104]

def MS2 : List (Nat × Nat) := [(32, 41), (32, 48), (32, 55), (32, 62), (32, 69), (32, 76), (32, 83), (32, 90), (32, 97), (32, 103), (33, 39), (33, 41), (33, 46), (33, 48), (33, 53), (33, 55), (33, 60), (33, 62), (33, 67), (33, 69), (33, 74), (33, 76), (33, 81), (33, 83), (33, 88), (33, 90), (33, 95), (33, 97), (33, 102), (33, 104), (34, 67), (34, 68), (34, 74), (34, 75), (34, 81), (34, 82), (34, 88), (34, 89), (34, 95), (34, 96), (34, 102), (34, 103), (39, 48), (39, 55), (39, 62), (39, 69), (39, 76), (39, 83), (39, 90), (39, 97), (39, 104), (40, 46), (40, 48), (40, 53), (40, 55), (40, 60), (40, 62), (40, 67), (40, 69), (40, 74), (40, 76), (40, 81), (40, 83), (40, 88), (40, 90), (40, 95), (40, 97), (41, 67), (41, 68), (41, 74), (41, 75), (41, 81), (41, 82), (41, 88), (41, 89), (41, 95), (41, 96), (46, 55), (46, 62), (46, 69), (46, 76), (46, 83), (46, 90), (46, 97), (46, 103), (47, 53), (47, 55), (47, 60), (47, 62), (47, 67), (47, 69), (47, 74), (47, 76), (47, 81), (47, 83), (47, 88), (47, 90), (47, 95), (47, 97), (47, 102), (47, 104), (48, 67), (48, 68), (48, 74), (48, 75), (48, 81), (48, 82), (48, 88), (48, 89), (48, 95), (48, 96), (48, 102), (48, 103), (53, 62), (53, 69), (53, 76), (53, 83), (53, 90), (53, 97), (53, 104), (54, 60), (54, 62), (54, 67), (54, 69), (54, 74), (54, 76), (54, 81), (54, 83), (54, 88), (54, 90), (54, 95), (54, 97), (55, 67), (55, 68), (55, 74), (55, 75), (55, 81), (55, 82), (55, 88), (55, 89), (55, 95), (55, 96), (60, 69), (60, 76), (60, 83), (60, 90), (60, 97), (60, 103), (61, 67), (61, 69), (61, 74), (61, 76), (61, 81), (61, 83), (61, 88), (61, 90), (61, 95), (61, 97), (61, 102), (61, 104), (62, 67), (62, 68), (62, 74), (62, 75), (62, 81), (62, 82), (62, 88), (62, 89), (62, 95), (62, 96), (62, 102), (62, 103), (67, 103), (67, 104), (68, 74), (68, 81), (68, 88), (68, 95), (68, 102), (69, 74), (69, 75), (69, 81), (69, 82), (69, 88), (69, 89), (69, 95), (69, 96), (69, 102), (69, 103), (75, 81), (75, 88), (75, 95), (75, 104), (76, 81), (76, 82), (76, 88), (76, 89), (76, 95), (76, 96), (81, 103), (81, 104), (82, 88), (82, 95), (82, 102), (83, 88), (83, 89), (83, 95), (83, 96), (83, 102), (83, 103), (89, 95), (89, 104), (90, 95), (90, 96), (95, 103), (95, 104), (96, 102), (97, 102), (97, 103)]

def M (l : List Nat) : Int :=
  if l.length = 0 then 1
  else if l.length = 1 then (if l.any (fun v => MS1.contains v) then 1 else 0)
  else if l.length = 2 then (if MS2.any (fun pr => l.contains pr.1 && l.contains pr.2) then 1 else 0)
  else 0

theorem SL_M : SL M := by
  intro l l' hl hl' hm
  have hlen := Programme.«20261026-1402-proof-complexity».RectExt.len_eq hl hl' hm
  have hc : ∀ x, l.contains x = l'.contains x := by
    intro x; apply Bool.eq_iff_iff.mpr; simp [hm x]
  have ha : l.any (fun v => MS1.contains v) = l'.any (fun v => MS1.contains v) := by
    apply Bool.eq_iff_iff.mpr; simp only [List.any_eq_true]
    exact ⟨fun ⟨x, hx, h⟩ => ⟨x, (hm x).mp hx, h⟩, fun ⟨x, hx, h⟩ => ⟨x, (hm x).mpr hx, h⟩⟩
  unfold M; rw [hlen, ha]; simp only [hc]


/-! ## `RRM` -/

def rp (i : Nat) : Nat := if i < 2 then 0 else if i < 4 then 1 else 2

def φRRM : Nat → List Nat → Int
  | 2 => M
  | _ => lf gR

def RRM : List Nat → Int := ProdM 3 rp rp 7 φRRM

theorem M_chk0 : (∀ i < 15, rp i = 2 → (2 : Int) ∣ locL 7 M [] (var 7 i) 7 (fun t => rp t = 2) - M []) ∧
    (∀ j < 7, rp j = 2 → (2 : Int) ∣ locL 7 M [] (fun s => var 7 s j) (7 + 8) (fun s => rp s = 2) - M []) := by
  decide +kernel

theorem M_chk1r : ∀ v < 105, blkM 3 rp rp 7 v = 2 →
    ∀ i < 15, rp i = 2 → v / 7 = i ∨ (2 : Int) ∣ locL 7 M [v] (var 7 i) 7 (fun t => rp t = 2) - M [v] := by
  decide +kernel

theorem M_chk1c : ∀ v < 105, blkM 3 rp rp 7 v = 2 →
    ∀ j < 7, rp j = 2 → v % 7 = j ∨
      (2 : Int) ∣ locL 7 M [v] (fun s => var 7 s j) 15 (fun s => rp s = 2) - M [v] := by
  decide +kernel

theorem M_loc : LocBal 2 3 rp rp 7 8 M 2 1 := by
  intro g' _ _ hb hl
  match g', hl with
  | [], _ =>
    exact ⟨fun i hi hbi _ => M_chk0.1 i hi hbi, fun j hj hbj _ => M_chk0.2 j hj hbj⟩
  | [v], _ =>
    have h1 := M_chk1r v (hb v (by simp)).1 (hb v (by simp)).2
    have h2 := M_chk1c v (hb v (by simp)).1 (hb v (by simp)).2
    exact ⟨fun i hi hbi hf => (h1 i hi hbi).resolve_left (hf v (by simp)),
      fun j hj hbj hf => (h2 j hj hbj).resolve_left (hf v (by simp))⟩

theorem rrm_bal (e : Nat) (he : e ≤ 3) : Bal 2 7 8 RRM RRM e := by
  apply bal_prodM 2 (fun i _ => by unfold rp; split <;> (try split) <;> omega)
    (fun j _ => by unfold rp; split <;> (try split) <;> omega) φRRM
    (fun c => by unfold φRRM; split; exact SL_M; exact SL_lf _)
    (fun c => if c = 2 then 0 else 1) (fun c => if c = 2 then 1 else 100)
  · intro c hc l hl
    match c, hc with
    | 0, _ => show gR l.length = 0; unfold gR; simp at hl; simp [hl]
    | 1, _ => show gR l.length = 0; unfold gR; simp at hl; simp [hl]
    | 2, _ => simp at hl
  · intro c hc
    match c, hc with
    | 0, _ => exact lf_locbal 2 3 rp rp 0 2 2 100 gR (by omega) (by omega) (by decide) (by decide) (by decide)
    | 1, _ => exact lf_locbal 2 3 rp rp 1 2 2 100 gR (by omega) (by omega) (by decide) (by decide) (by decide)
    | 2, _ => exact M_loc
  · have : ∀ e ≤ 3, ∀ b < 3, e ≤ (fun c => if c = 2 then 1 else 100) b +
        natSum 3 (fun c => if c = b then 0 else (fun c => if c = 2 then 0 else 1) c) := by decide
    exact this e he


/-! ## `RRRM` -/

def qp (i : Nat) : Nat := if i < 2 then 0 else if i < 4 then 1 else if i < 6 then 2 else 3

def φRRRM : Nat → List Nat → Int
  | 3 => lf g1
  | _ => lf gR

def RRRM : List Nat → Int := ProdM 4 qp qp 7 φRRRM

theorem rrrm_bal (e : Nat) (he : e ≤ 3) : Bal 2 7 8 RRRM RRRM e := by
  apply bal_prodM 2 (fun i _ => by unfold qp; split <;> (try split) <;> (try split) <;> omega)
    (fun j _ => by unfold qp; split <;> (try split) <;> (try split) <;> omega) φRRRM
    (fun c => by unfold φRRRM; split <;> exact SL_lf _)
    (fun c => if c = 3 then 0 else 1) (fun c => if c = 3 then 0 else 100)
  · intro c hc l hl
    match c, hc with
    | 0, _ | 1, _ | 2, _ => show gR l.length = 0; unfold gR; simp at hl; simp [hl]
    | 3, _ => simp at hl
  · intro c hc
    match c, hc with
    | 0, _ => exact lf_locbal 2 4 qp qp 0 2 2 100 gR (by omega) (by omega) (by decide) (by decide) (by decide)
    | 1, _ => exact lf_locbal 2 4 qp qp 1 2 2 100 gR (by omega) (by omega) (by decide) (by decide) (by decide)
    | 2, _ => exact lf_locbal 2 4 qp qp 2 2 2 100 gR (by omega) (by omega) (by decide) (by decide) (by decide)
    | 3, _ => exact lf_locbal 2 4 qp qp 3 9 1 0 g1 (by omega) (by omega) (by decide) (by decide) (by decide)
  · have : ∀ e ≤ 3, ∀ b < 4, e ≤ (fun c => if c = 3 then 0 else 100) b +
        natSum 4 (fun c => if c = b then 0 else (fun c => if c = 3 then 0 else 1) c) := by decide
    exact this e he

/-! ## `RBd` -/

def bpR (i : Nat) : Nat := if i < 12 then 0 else if i < 14 then 1 else 2
def bhR (j : Nat) : Nat := if j < 4 then 0 else if j < 6 then 1 else 2

theorem bpR0 (i : Nat) : bpR i = 0 ↔ i < 12 := by unfold bpR; split <;> (try split) <;> omega
theorem bhR0 (j : Nat) : bhR j = 0 ↔ j < 4 := by unfold bhR; split <;> (try split) <;> omega

def φRBd : Nat → List Nat → Int
  | 0 => Programme.«20261027-1434-proof-complexity».HDes.B7
  | 1 => lf gR
  | _ => lf g1

def RBd : List Nat → Int := ProdM 3 bpR bhR 7 φRBd

theorem rbd_bal (e : Nat) (he : e ≤ 3) : Bal 2 7 8 RBd RBd e := by
  apply bal_prodM 2 (fun i _ => by unfold bpR; split <;> (try split) <;> omega)
    (fun j _ => by unfold bhR; split <;> (try split) <;> omega) φRBd
    (fun c => by unfold φRBd; split; exact Programme.«20261027-1434-proof-complexity».HDes.SL_B7; exact SL_lf _; exact SL_lf _)
    (fun c => if c = 1 then 1 else 0) (fun c => if c = 0 then 2 else 100)
  · intro c hc l hl
    match c, hc with
    | 1, _ => show gR l.length = 0; unfold gR; simp at hl; simp [hl]
    | 0, _ | 2, _ => simp at hl
  · intro c hc
    match c, hc with
    | 0, _ => exact b7_loc 3 bpR bhR (by omega) bpR0 bhR0
    | 1, _ => exact lf_locbal 2 3 bpR bhR 1 2 2 100 gR (by omega) (by omega) (by decide) (by decide) (by decide)
    | 2, _ => exact lf_locbal 2 3 bpR bhR 2 1 1 100 g1 (by omega) (by omega) (by decide) (by decide) (by decide)
  · have : ∀ e ≤ 3, ∀ b < 3, e ≤ (fun c => if c = 0 then 2 else 100) b +
        natSum 3 (fun c => if c = b then 0 else (fun c => if c = 1 then 1 else 0) c) := by decide
    exact this e he

/-! ## `TB` -/

theorem hbp0 (i : Nat) : Programme.«20261027-1434-proof-complexity».HDes.bp i = 0 ↔ i < 12 := by unfold Programme.«20261027-1434-proof-complexity».HDes.bp; split <;> omega
theorem hbh0 (j : Nat) : Programme.«20261027-1434-proof-complexity».HDes.bh j = 0 ↔ j < 4 := by unfold Programme.«20261027-1434-proof-complexity».HDes.bh; split <;> omega

def φTB : Nat → List Nat → Int
  | 0 => Programme.«20261027-1434-proof-complexity».HDes.B7
  | _ => lf gT

def TB : List Nat → Int := ProdM 2 Programme.«20261027-1434-proof-complexity».HDes.bp Programme.«20261027-1434-proof-complexity».HDes.bh 7 φTB

theorem tb_bal (e : Nat) (he : e ≤ 3) : Bal 2 7 8 TB TB e := by
  apply bal_prodM 2 (fun i _ => by unfold Programme.«20261027-1434-proof-complexity».HDes.bp; split <;> omega)
    (fun j _ => by unfold Programme.«20261027-1434-proof-complexity».HDes.bh; split <;> omega) φTB
    (fun c => by unfold φTB; split; exact Programme.«20261027-1434-proof-complexity».HDes.SL_B7; exact SL_lf _)
    (fun c => if c = 1 then 2 else 0) (fun c => if c = 0 then 2 else 100)
  · intro c hc l hl
    match c, hc with
    | 1, _ => show gT l.length = 0; unfold gT; simp at hl; simp [show ¬ 2 ≤ l.length by omega]
    | 0, _ => simp at hl
  · intro c hc
    match c, hc with
    | 0, _ => exact b7_loc 2 Programme.«20261027-1434-proof-complexity».HDes.bp Programme.«20261027-1434-proof-complexity».HDes.bh (by omega) hbp0 hbh0
    | 1, _ => exact lf_locbal 2 2 Programme.«20261027-1434-proof-complexity».HDes.bp Programme.«20261027-1434-proof-complexity».HDes.bh 1 3 3 100 gT (by omega) (by omega) (by decide) (by decide) (by decide)
  · have : ∀ e ≤ 3, ∀ b < 2, e ≤ (fun c => if c = 0 then 2 else 100) b +
        natSum 2 (fun c => if c = b then 0 else (fun c => if c = 1 then 2 else 0) c) := by decide
    exact this e he

/-- **All four towers are self-balanced at every level `e ≤ 3`.** -/
theorem towers_bal (e : Nat) (he : e ≤ 3) :
    Bal 2 7 8 RBd RBd e ∧ Bal 2 7 8 TB TB e ∧ Bal 2 7 8 RRM RRM e ∧ Bal 2 7 8 RRRM RRRM e :=
  ⟨rbd_bal e he, tb_bal e he, rrm_bal e he, rrrm_bal e he⟩

end Programme.«20261027-1434-proof-complexity».Towers

