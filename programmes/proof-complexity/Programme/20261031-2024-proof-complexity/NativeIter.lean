import Programme.«20261024-1110-proof-complexity».Haken

namespace Programme.«20261031-2024-proof-complexity».NativeIter

abbrev Var := Nat × Nat
abbrev Lit := Var × Bool
abbrev Assignment := Var → Bool
abbrev Clause := List Lit

def neg (l : Lit) : Lit := (l.1, !l.2)
def holds (a : Assignment) (l : Lit) : Bool := a l.1 == l.2
def conjunction (ls : List Lit) (a : Assignment) : Rat :=
  if ls.all (holds a) then 1 else 0

def word (b x v : Nat) : List Lit :=
  (List.range b).map fun j => ((x,j), v.testBit j)

def forbid (event : List Lit) : Clause := (event.map neg).eraseDups

/-- Python `(n-1).bit_length()`, including the zero-bit case n=1. -/
def bits (n : Nat) : Nat := if n ≤ 1 then 0 else (n-1).log2 + 1

/-- Domain, root, descending-edge, and proper-sink clauses, in generator order.
Variables `(x,j)` correspond to Python variable number `1+x*b+j`. -/
def cnfAt (n b : Nat) : List Clause :=
  let domain := (List.range n).flatMap fun x =>
    ((List.range (2^b)).filter fun v => n ≤ v).map fun v => forbid (word b x v)
  let events := (List.range n).flatMap fun x =>
    (if x = 0 then [word b 0 0] else []) ++
    ((List.range x).map fun z => word b x z) ++
    (((List.range n).filter fun z => x < z).map fun z => word b x z ++ word b z z)
  (domain ++ events.map forbid).eraseDups

def cnf (n : Nat) : List Clause := cnfAt n (bits n)

/-- Distinct multiplier variables, exactly the combinations/signs in `rows`. -/
def Multiplier (m : List Lit) : Prop := (m.map Prod.fst).Nodup

def falsity (c : Clause) : List Lit := c.map neg

/-- The formal, unreduced admission test. -/
def Admitted (d : Nat) (c : Clause) (m : List Lit) : Prop :=
  Multiplier m ∧ m.length + c.length ≤ d

/-- The cone generated by nonnegative literal conjunctions and signed admitted
clause-falsity multiples. Equality is equality of Boolean multilinear functions. -/
inductive Cone (F : List Clause) (d : Nat) : (Assignment → Rat) → Prop where
  | positive (m) : Multiplier m → m.length ≤ d → Cone F d (conjunction m)
  | equation (c) (m) (r : Rat) : c ∈ F → Admitted d c m →
      Cone F d (fun a => r * conjunction (m ++ falsity c) a)
  | zero : Cone F d (fun _ => 0)
  | add {f g} : Cone F d f → Cone F d g → Cone F d (fun a => f a + g a)
  | scale {f} (r : Rat) : 0 ≤ r → Cone F d f → Cone F d (fun a => r * f a)

def Refutes (F : List Clause) (d : Nat) : Prop := Cone F d (fun _ => -1)

/-- Degree-filtered satisfaction; clauses wider than d impose no constraint. -/
def SatisfiesAt (F : List Clause) (d : Nat) (a : Assignment) : Prop :=
  ∀ c ∈ F, c.length ≤ d → conjunction (falsity c) a = 0

theorem conjunction_nonneg (m : List Lit) (a : Assignment) :
    0 ≤ conjunction m a := by
  unfold conjunction
  split <;> decide

theorem conjunction_append_zero (m c : List Lit) (a : Assignment)
    (h : conjunction c a = 0) : conjunction (m ++ c) a = 0 := by
  simp only [conjunction, List.all_append] at *
  cases hc : c.all (holds a) <;> simp_all

theorem cone_nonneg {F d a} (h : SatisfiesAt F d a) {f}
    (hf : Cone F d f) : 0 ≤ f a := by
  induction hf with
  | positive m _ _ => exact conjunction_nonneg m a
  | equation c m r hc hd =>
    have hz := h c hc (by have := hd.2; omega)
    change 0 ≤ r * conjunction (m ++ falsity c) a
    rw [conjunction_append_zero m (falsity c) a hz]
    simp
  | zero => exact Rat.le_refl
  | add _ _ ih jh => exact Rat.add_nonneg ih jh
  | scale r hr _ ih => exact Rat.mul_nonneg hr ih

theorem no_refutation_of_filtered_assignment {F d a} (h : SatisfiesAt F d a) :
    ¬ Refutes F d := by
  intro hf
  have hh : (0 : Rat) ≤ -1 := cone_nonneg h hf
  contradiction

#print axioms no_refutation_of_filtered_assignment
end Programme.«20261031-2024-proof-complexity».NativeIter
