import Programme.«20261024-1110-proof-complexity».Haken
/-!
# Checking concrete refutations against `Work.Haken.Refutation`

A Boolean checker for resolution refutations given with per-step hints, a soundness theorem
turning a successful check into a `Refutation F` (the type of the lower bound `Work.Haken.haken`),
and a certified refutation of `PHP 2` (3 pigeons, 2 holes) checked by `decide`.
-/

namespace Programme.«20261024-1110-proof-complexity».Haken

/-- Justification of a step: an axiom, or a resolvent of steps `a`, `b` on variable `x`. -/
inductive Just (V : Type) where
  | ax
  | res (a b : Nat) (x : V)
deriving Repr

def resB {V} [DecidableEq V] (A B C : Clause V) (x : V) : Bool :=
  decide (⟨x, true⟩ ∈ A) && decide (⟨x, false⟩ ∈ B) &&
    A.all (fun l => decide (l = ⟨x, true⟩) || decide (l ∈ C)) &&
    B.all (fun l => decide (l = ⟨x, false⟩) || decide (l ∈ C))

theorem resB_sound {V} [DecidableEq V] {A B C : Clause V} {x : V} (h : resB A B C x = true) :
    IsResolvent A B C := by
  simp only [resB, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, Bool.or_eq_true] at h
  obtain ⟨⟨⟨hA, hB⟩, hAC⟩, hBC⟩ := h
  exact ⟨x, hA, hB, fun l hl hne => (hAC l hl).resolve_left hne,
    fun l hl hne => (hBC l hl).resolve_left hne⟩

def stepOK {V} [DecidableEq V] (F : CNF V) (steps : List (Clause V)) (k : Nat) : Just V → Bool
  | .ax => match steps[k]? with
    | some C => decide (C ∈ F)
    | none => false
  | .res a b x => match steps[k]?, steps[a]?, steps[b]? with
    | some C, some A, some B => decide (a < k) && decide (b < k) && resB A B C x
    | _, _, _ => false

/-- Check a hinted refutation: same length as the hints, every step justified, `[]` occurs. -/
def check {V} [DecidableEq V] (F : CNF V) (steps : List (Clause V)) (js : List (Just V)) : Bool :=
  decide (([] : Clause V) ∈ steps) && decide (js.length = steps.length) &&
    (List.range steps.length).all fun k => match js[k]? with
      | some j => stepOK F steps k j
      | none => false

/-- A successful check yields a `Refutation` with exactly these steps. -/
def Refutation.ofCheck {V} [DecidableEq V] (F : CNF V) (steps : List (Clause V)) (js : List (Just V))
    (h : check F steps js = true) : Refutation F where
  steps := steps
  empty_mem := by
    simp only [check, Bool.and_eq_true, decide_eq_true_eq] at h; exact h.1.1
  derived := by
    intro k hk
    simp only [check, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range] at h
    have hk' := h.2 k hk
    have hjl : k < js.length := by omega
    rw [List.getElem?_eq_getElem hjl] at hk'
    generalize js[k] = j at hk'
    cases j with
    | ax =>
      left
      simp only [stepOK, List.getElem?_eq_getElem hk, decide_eq_true_eq] at hk'
      exact hk'
    | res a b x =>
      right
      simp only [stepOK, List.getElem?_eq_getElem hk] at hk'
      split at hk'
      · rename_i C A B hC hA hB
        cases hC
        simp only [Bool.and_eq_true, decide_eq_true_eq] at hk'
        obtain ⟨⟨ha, hb⟩, hr⟩ := hk'
        have ha' : a < steps.length := by omega
        have hb' : b < steps.length := by omega
        rw [List.getElem?_eq_getElem ha'] at hA
        rw [List.getElem?_eq_getElem hb'] at hB
        cases hA; cases hB
        exact ⟨a, b, ha, hb, resB_sound hr⟩
      · exact absurd hk' (by simp)

theorem ofCheck_steps {V} [DecidableEq V] (F : CNF V) (steps : List (Clause V)) (js : List (Just V))
    (h : check F steps js = true) : (Refutation.ofCheck F steps js h).steps = steps := rfl

/-! ## A certified refutation of `PHP 2` (3 pigeons, 2 holes) -/

/-- Generated by a DPLL-tree script: steps 0–8 are the axioms of `PHP 2` in order, the rest are
resolvents. -/
def php2Steps : List (Clause (Nat × Nat)) :=
  [ [⟨(0, 0), true⟩, ⟨(0, 1), true⟩],
    [⟨(1, 0), true⟩, ⟨(1, 1), true⟩],
    [⟨(2, 0), true⟩, ⟨(2, 1), true⟩],
    [⟨(0, 0), false⟩, ⟨(1, 0), false⟩],
    [⟨(0, 0), false⟩, ⟨(2, 0), false⟩],
    [⟨(1, 0), false⟩, ⟨(2, 0), false⟩],
    [⟨(0, 1), false⟩, ⟨(1, 1), false⟩],
    [⟨(0, 1), false⟩, ⟨(2, 1), false⟩],
    [⟨(1, 1), false⟩, ⟨(2, 1), false⟩],
    [⟨(0, 1), false⟩, ⟨(1, 0), true⟩],
    [⟨(0, 1), false⟩, ⟨(2, 0), true⟩],
    [⟨(0, 1), false⟩, ⟨(1, 0), false⟩],
    [⟨(0, 1), false⟩],
    [⟨(0, 0), true⟩],
    [⟨(1, 1), false⟩, ⟨(2, 0), true⟩],
    [⟨(0, 0), false⟩, ⟨(1, 1), false⟩],
    [⟨(0, 0), false⟩, ⟨(1, 0), true⟩],
    [⟨(0, 0), false⟩],
    [] ]

def php2Hints : List (Just (Nat × Nat)) :=
  [ .ax, .ax, .ax, .ax, .ax, .ax, .ax, .ax, .ax, .res 1 6 (1, 1), .res 2 7 (2, 1), .res 10 5 (2, 0), .res 9 11 (1, 0), .res 0 12 (0, 1), .res 2 8 (2, 1), .res 14 4 (2, 0), .res 1 15 (1, 1), .res 16 3 (1, 0), .res 13 17 (0, 0) ]

theorem php2_check : check (PHP 2) php2Steps php2Hints = true := by decide

/-- A certified 19-clause resolution refutation of `PHP 2`, of the same type as the lower bound. -/
def php2Refutation : Refutation (PHP 2) := Refutation.ofCheck _ _ _ php2_check

theorem php2Refutation_size : php2Refutation.steps.length = 19 := rfl

/-- Upper bound: `PHP 2` has a resolution refutation with 19 clauses. -/
theorem php2_upper : ∃ R : Refutation (PHP 2), R.steps.length = 19 :=
  ⟨php2Refutation, php2Refutation_size⟩

end Programme.«20261024-1110-proof-complexity».Haken

