import Programme.«20261104-1627-proof-complexity».DirectND

namespace Programme.«20261104-1627-proof-complexity».AnchoredLucasLowering
open Programme.«20261024-1633-proof-complexity».NS
open Programme.«20261025-1627-proof-complexity».NoDrop
open Programme.«20261025-0459-proof-complexity».OntoFPHP
open Programme.«20261025-0459-proof-complexity».OntoLucas
open Programme.«20261104-1627-proof-complexity».MatchingLabels

/-- This consumes the anchored identity as an explicit hypothesis; it does not
prove telescoping or assume that all Kernel vectors are generated by z. -/
theorem anchored_lowering {n k s t : Nat} (N : Matching)
    (hk : 9 ∣ k) (hs : s ≤ n) (ht : t < 9)
    (identity : W 3 (n+k) n (s+t-1)
      ((rho n (z (n+k) n t N)).sub
        ⟨[((bin (n+k-s) t : Int) - bin (n-s) t, mono n N)]⟩)) :
    NSIn 3 (ontoFPHP n k) (s+t-1) (rho n (z (n+k) n t N)).eval := by
  apply nsIn_congr
    (Programme.«20261104-1627-proof-complexity».BoundedRelationCertificates.W_nsIn identity)
  intro a
  rw [eval_sub]
  have hc := Programme.«20261104-1627-proof-complexity».DirectND.lucas_three_nine hk hs ht
  obtain ⟨c, hc⟩ := hc
  have hd : (3 : Int) ∣ ((bin (n+k-s) t : Int) - bin (n-s) t) * monoEval a (mono n N) := by
    refine ⟨c * monoEval a (mono n N), ?_⟩
    rw [hc, Int.mul_assoc]
  have he : ∀ x y : Int, x - (x - y) = y := by intros; omega
  rw [he]
  simpa [Poly.eval] using hd

#print axioms anchored_lowering
end Programme.«20261104-1627-proof-complexity».AnchoredLucasLowering
