import Programme.«20261021-1639-ontological».Atlas.FilterAxis
/- Adapted from th, P143; proof reuse, not independent verification.
D11: principality is orthogonal to collapse. With F1 fixed (current-world or boxed principal
generation), the 2×2×2 cube {principal, non-principal} × {A4, ¬A4} × {current-world, boxed}
has collapse forced exactly in the cells with current-world inclusion and A4.
Non-principal witnesses use the Fréchet (cofinite) filter on ℕ; no choice needed for them. -/
namespace Programme.«20261021-1639-ontological».Atlas.PrincipalAxis
open Programme.«20261021-1639-ontological».Atlas.ScottTable Programme.«20261021-1639-ontological».Atlas.FilterAxis
open Programme.«20261021-1639-ontological».Countermodels.Tests Programme.«20261021-1639-ontological».Countermodels.Scott Programme.«20261021-1639-ontological».Atlas.Scott
variable {W E : Type} (m : Model W E) (a : Bool)

/-- F1, current-world reading: P(w) is generated by g w under guarded inclusion at w. -/
def F1cw : Prop := ∀ w, ∃ g : E → W → Prop, ∀ p,
  m.positive p w ↔ ∀ x, guard m a x w → g x w → p x w
/-- F1, boxed reading: P(w) is generated by g under guarded inclusion at every successor. -/
def F1box : Prop := ∀ w, ∃ g : E → W → Prop, ∀ p,
  m.positive p w ↔ ∀ v, m.rel w v → ∀ x, guard m a x v → g x v → p x v

theorem cw_of_F1cw (h : F1cw m a) : HasU m ∧ UpCW m a ∧ Inter m := by
  refine ⟨fun w => ?_, fun p q w hp hpq => ?_, fun p q w hp hq => ?_⟩
  · obtain ⟨g, hg⟩ := h w; exact (hg _).2 fun _ _ _ => trivial
  · obtain ⟨g, hg⟩ := h w
    exact (hg q).2 fun x hx hgx => hpq x hx ((hg p).1 hp x hx hgx)
  · obtain ⟨g, hg⟩ := h w
    exact (hg _).2 fun x hx hgx => ⟨(hg p).1 hp x hx hgx, (hg q).1 hq x hx hgx⟩

theorem A2_of_F1box (h : F1box m a) : A2 m a := by
  intro p q w hp hpq
  obtain ⟨g, hg⟩ := h w
  exact (hg q).2 fun v hv x hx hgx => hpq v hv x hx ((hg p).1 hp v hv x hx hgx)

/-- Collapse from F1cw + A4 + ∅ not positive: no ultrafilter, no A1–A3, no A5, any frame. -/
theorem id_of_F1cw_A4 (h : F1cw m a) (h0 : NoEmpty m) (h4 : A4 m) :
    ∀ w v, m.rel w v → w = v :=
  let ⟨hU, hup, _⟩ := cw_of_F1cw m a h
  id_of_cw_A4 m a hU h0 hup h4

/-- Explicit MC corollary requested in the K40 audit. -/
theorem mc_of_F1cw_A4 (h : F1cw m a) (h0 : NoEmpty m) (h4 : A4 m) : MC m :=
  mc_of_id m (id_of_F1cw_A4 m a h h0 h4)

theorem mc_of_FilterCW_A4 (h : FilterCW m a) (h4 : A4 m) : MC m :=
  mc_of_id m (id_of_cw_A4 m a h.1 h.2.1 h.2.2.1 h4)

/-- Scott A3 and current-world upward closure generate positivity by G; cf. sk P149. -/
theorem F1cw_of_A3 (h3 : A3 m) (hu : UpCW m a) : F1cw m a := by
  intro w
  exact ⟨G m, fun p => ⟨fun hp x _ hg => hg p hp,
    fun h => hu (G m) p w (h3 w) h⟩⟩

/-- Scott A3, boxed upward closure and rigidity generate positivity by G; cf. sk P149. -/
theorem F1box_of_A3 (h3 : A3 m) (h2 : A2 m a) (h4 : A4 m) : F1box m a := by
  intro w
  exact ⟨G m, fun p => ⟨fun hp v hv x _ hg => hg p (h4 p w hp v hv),
    fun h => h2 (G m) p w (h3 w) h⟩⟩

#print axioms mc_of_F1cw_A4
#print axioms mc_of_FilterCW_A4
#print axioms F1cw_of_A3
#print axioms F1box_of_A3

/-! Witnesses. Entities ℕ, all actual, universal frame on `W`. -/
def univN (W : Type) (pos : (Nat → W → Prop) → W → Prop) : Model W Nat :=
  ⟨fun _ _ => True, fun _ _ => True, pos⟩

def cof (s : Nat → Prop) : Prop := ∃ N, ∀ n, N ≤ n → s n

/-- Fréchet filter at the current world. -/
def frechetLocal (W : Type) : Model W Nat := univN W fun p w => cof (fun n => p n w)
/-- Fréchet filter read off the fixed world `false` (rigid). -/
def frechetRigid : Model Bool Nat := univN Bool fun p _ => cof (fun n => p n false)

theorem cof_ne (N : Nat) : cof (fun n => n ≠ N) :=
  ⟨N + 1, fun _ h e => by omega⟩

theorem frechetLocal_filter (W : Type) : FilterCW (frechetLocal W) a :=
  ⟨fun _ => ⟨0, fun _ _ => trivial⟩, fun _ ⟨N, h⟩ => h N (Nat.le_refl _),
   fun _ _ _ ⟨N, h⟩ hpq => ⟨N, fun n hn => hpq n (fun _ => trivial) (h n hn)⟩,
   fun _ _ _ ⟨N, h⟩ ⟨M, k⟩ => ⟨N + M, fun n hn => ⟨h n (by omega), k n (by omega)⟩⟩⟩

theorem frechetLocal_not_F1cw (W : Type) [Inhabited W] : ¬ F1cw (frechetLocal W) a := by
  intro h
  obtain ⟨g, hg⟩ := h default
  obtain ⟨N, hN⟩ := (hg g).2 fun _ _ h => h
  exact (hg (fun n _ => n ≠ N)).1 (cof_ne N) N (fun _ => trivial) (hN N (Nat.le_refl _)) rfl

theorem frechetLocal_A4_unit : A4 (frechetLocal Unit) := fun _ _ h _ _ => h
theorem frechetLocal_MC_unit : MC (frechetLocal Unit) := fun _ _ h _ _ => h

theorem frechetLocal_not_A4 : ¬ A4 (frechetLocal Bool) := by
  intro h
  obtain ⟨N, hN⟩ := h (fun _ w => w = false) false ⟨0, fun _ _ => rfl⟩ true trivial
  exact Bool.noConfusion (hN N (Nat.le_refl _))

theorem frechetLocal_A2 : A2 (frechetLocal Bool) a := fun _ _ w ⟨N, h⟩ hpq =>
  ⟨N, fun n hn => hpq w trivial n (fun _ => trivial) (h n hn)⟩

theorem not_MC_univN (pos) : ¬ MC (univN Bool pos) := fun h =>
  Bool.false_ne_true (h (fun w => w = false) false rfl true trivial).symm

theorem frechetRigid_props : HasU frechetRigid ∧ NoEmpty frechetRigid ∧ Inter frechetRigid ∧
    A2 frechetRigid a ∧ A4 frechetRigid ∧ ¬ UpCW frechetRigid a ∧ ¬ F1box frechetRigid a ∧
    ¬ MC frechetRigid := by
  refine ⟨fun _ => ⟨0, fun _ _ => trivial⟩, fun _ ⟨N, h⟩ => h N (Nat.le_refl _),
    fun _ _ _ ⟨N, h⟩ ⟨M, k⟩ => ⟨N + M, fun n hn => ⟨h n (by omega), k n (by omega)⟩⟩,
    fun _ _ _ ⟨N, h⟩ hpq => ⟨N, fun n hn => hpq false trivial n (fun _ => trivial) (h n hn)⟩,
    fun _ _ h _ _ => h, ?_, ?_, not_MC_univN _⟩
  · intro h
    obtain ⟨N, hN⟩ := h (fun _ _ => True) (fun _ v => v = true) true ⟨0, fun _ _ => trivial⟩
      (fun _ _ _ => rfl)
    exact Bool.noConfusion (hN N (Nat.le_refl _))
  · intro h
    obtain ⟨g, hg⟩ := h false
    obtain ⟨N, hN⟩ := (hg g).2 fun _ _ _ _ h => h
    exact (hg (fun n v => ¬ (n = N ∧ v = false))).1
      ⟨N + 1, fun n hn ⟨e, _⟩ => by omega⟩ false trivial N (fun _ => trivial)
      (hN N (Nat.le_refl _)) ⟨rfl, rfl⟩

/-- Principal cells reuse D9's models: `localP` (cw- and boxed-principal, ¬A4),
`rigidP` (boxed-principal, A4, ¬UpCW). -/
theorem localP_F1 : F1cw localP a ∧ F1box localP a ∧ ¬ A4 localP ∧ ¬ MC localP := by
  refine ⟨fun w => ⟨fun _ _ => True, fun p => ⟨fun hp x _ _ => hp, fun h => h () (fun _ => trivial) trivial⟩⟩,
    fun w => ⟨fun _ v => v = w, fun p => ⟨fun hp v _ x _ hv => by cases x; subst hv; exact hp,
      fun h => h w trivial () (fun _ => trivial) rfl⟩⟩, ?_, univ2_not_mc _ _⟩
  exact fun h => Bool.noConfusion (h (fun _ w => w = false) false rfl true trivial)

theorem rigidP_F1box : F1box rigidP a ∧ A4 rigidP ∧ ¬ MC rigidP :=
  ⟨fun _ => ⟨fun _ v => v = false, fun p => ⟨fun hp v _ x _ hv => by cases x; subst hv; exact hp,
      fun h => h false trivial () (fun _ => trivial) rfl⟩⟩,
   fun _ _ h _ _ => h, univ2_not_mc _ _⟩

/-- Added in the rebase: the non-rigid boxed cell also requires failure of F1box. -/
theorem frechetLocal_not_F1box : ¬ F1box (frechetLocal Bool) a := by
  intro h
  obtain ⟨g, hg⟩ := h false
  obtain ⟨N, hN⟩ := (hg g).2 fun _ _ _ _ h => h
  exact (hg (fun n _ => n ≠ N)).1 (cof_ne N) false trivial N
    (fun _ => trivial) (hN N (Nat.le_refl _)) rfl

def FilterBox : Prop := HasU m ∧ NoEmpty m ∧ A2 m a ∧ Inter m

theorem univN_s5 (W : Type) (pos) : S5 (univN W pos) :=
  ⟨⟨fun _ => trivial, fun _ _ _ _ _ => trivial⟩, fun _ _ _ => trivial⟩

/-- Principal non-rigid witness, for both inclusion scopes. -/
theorem principal_nonrigid :
    S5 localP ∧ FilterCW localP a ∧ FilterBox localP a ∧
    F1cw localP a ∧ F1box localP a ∧ ¬ A4 localP ∧ ¬ MC localP := by
  obtain ⟨hc, hb, h4, hm⟩ := localP_F1 a
  have hf := (drop_A4 a).1
  exact ⟨univ2_s5 _ _, hf, ⟨hf.1, hf.2.1, A2_of_F1box _ a hb, hf.2.2.2⟩,
    hc, hb, h4, hm⟩

/-- Non-principal non-rigid witness, for both inclusion scopes. -/
theorem nonprincipal_nonrigid :
    S5 (frechetLocal Bool) ∧ FilterCW (frechetLocal Bool) a ∧
    FilterBox (frechetLocal Bool) a ∧ ¬ F1cw (frechetLocal Bool) a ∧
    ¬ F1box (frechetLocal Bool) a ∧ ¬ A4 (frechetLocal Bool) ∧
    ¬ MC (frechetLocal Bool) := by
  have hf := frechetLocal_filter a Bool
  exact ⟨univN_s5 _ _, hf, ⟨hf.1, hf.2.1, frechetLocal_A2 a, hf.2.2.2⟩,
    frechetLocal_not_F1cw a Bool, frechetLocal_not_F1box a,
    frechetLocal_not_A4, not_MC_univN _⟩

/-- Principal rigid witness, with boxed inclusion. -/
theorem principal_rigid_box : S5 rigidP ∧ FilterBox rigidP a ∧
    F1box rigidP a ∧ A4 rigidP ∧ ¬ MC rigidP := by
  obtain ⟨hu, h0, _, hi, h2, _, _⟩ := drop_UpCW a
  obtain ⟨hf, h4, hm⟩ := rigidP_F1box a
  exact ⟨univ2_s5 _ _, ⟨hu, h0, h2, hi⟩, hf, h4, hm⟩

/-- Non-principal rigid witness, with boxed inclusion. -/
theorem nonprincipal_rigid_box : S5 frechetRigid ∧ FilterBox frechetRigid a ∧
    ¬ F1box frechetRigid a ∧ A4 frechetRigid ∧ ¬ MC frechetRigid := by
  obtain ⟨hu, h0, hi, h2, h4, _, hf, hm⟩ := frechetRigid_props a
  exact ⟨univN_s5 _ _, ⟨hu, h0, h2, hi⟩, hf, h4, hm⟩

/-- The collapsing current-world rigid cell is consistent even without principality. -/
theorem nonprincipal_rigid_cw : S5 (frechetLocal Unit) ∧
    FilterCW (frechetLocal Unit) a ∧ ¬ F1cw (frechetLocal Unit) a ∧
    A4 (frechetLocal Unit) ∧ MC (frechetLocal Unit) :=
  ⟨univN_s5 _ _, frechetLocal_filter a Unit, frechetLocal_not_F1cw a Unit,
    frechetLocal_A4_unit, frechetLocal_MC_unit⟩

