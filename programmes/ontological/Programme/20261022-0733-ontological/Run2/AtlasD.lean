import Programme.«20261022-0733-ontological».Run2.RigidFree

/-! # Thread D: dropping rigidity alone blocks collapse while principality is kept (E7 model)

arXiv 2608.07578 asks whether the ways out of modal collapse (dropping principality vs dropping
rigidity of positivity) are distinct.  th's E7 model `RigidFree.cantor` keeps a *principal*
positivity, `P` = the properties of the (unique, everywhere God-like) entity, satisfies `Ax2a`,
`Ax3`, `Ax4`, `L` and every `Ax1Gen` form, and fails rigidity (`Ax2b`) and admitted modal collapse.
It is a model of K1's `Closed` interface; sk (P75) showed it is not `𝓛`-general, so this is an
interface-level exit. -/

namespace Programme.«20261022-0733-ontological».Run2.AtlasD

open Programme.«20261022-0733-ontological».Run2.TwoClosed Programme.«20261022-0733-ontological».Run2.DropDagger Programme.«20261022-0733-ontological».Run2.OneHF
  Programme.«20261022-0733-ontological».Run2.BoxIdle Programme.«20261022-0733-ontological».Run2.UniqueEss Programme.«20261022-0733-ontological».Run2.RigidFree

/-- Positivity in `cantor` is the principal filter generated by God-likeness. -/
theorem cantor_principal (φ : Unit → Cw → Prop) (w : Cw) :
    cantor.P φ w ↔ ∀ x, G cantor x w → φ x w :=
  ⟨fun h x _ => by cases x; exact h, fun h => h () (god_all () w)⟩

/-- **Exit by rigidity alone.**  Principal positivity, Ax2a, Ax3 (v2, 3′), Ax4, `L`, `Ax1Gen`,
an actual God-like being at every world, an S5 frame; neither `Ax2b` nor admitted MC. -/
theorem rigidity_exit :
    Closed cantor ∧ (∀ φ w, cantor.P φ w ↔ ∀ x, G cantor x w → φ x w) ∧
      Ax2a cantor ∧ Ax3 cantor ∧ Ax3v3 cantor ∧ Ax4 cantor ∧ L cantor ∧ Ax1Gen cantor ∧
      (∀ w, ExG cantor w) ∧ (∀ w v, cantor.R w v) ∧ ¬ Ax2b cantor ∧ ¬ MC cantor :=
  ⟨closed, cantor_principal, ax2a, ax3, ax3v3, ax4, l, ax1Gen, exG_all, fun _ _ => trivial,
    not_ax2b, not_mc⟩

end Programme.«20261022-0733-ontological».Run2.AtlasD

