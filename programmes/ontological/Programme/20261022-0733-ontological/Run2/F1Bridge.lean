import Programme.«20261022-0733-ontological».Run2.Principal

/-! Copied from th's `Programme/Th/F1Bridge.lean` (author th); namespace and import changed.

# Bridge between the Henkin principality `Princ` (K38) and the library's `F1cw`

The library's `PrincipalAxis.F1cw m a` (full intensions, `Countermodels.Tests.Model`) says that
positivity at `w` is generated by a *set* `g` of entities under guarded inclusion at `w`.
K38's `Princ M w` (Henkin, `Run2.Model`) says it is principal at a *single* actual entity.
`full m` reads a library model as a `Run2.Model` with every carrier full.

* `F1cw_of_princ`: `Princ` at every world gives `F1cw` in both guard regimes.
* `princ_of_F1cw`: actualist `F1cw` plus `Ax2a` gives `Princ` at every world
  (the generator set is a singleton).
* `princ_of_F1cw_poss`: possibilist `F1cw` plus `Ax2a` gives principality at a single entity,
  which need not be actual.
* `not_princ_of_F1cw`: `F1cw` alone does not give `Princ`: a one-world model with two actual
  entities, positivity = shared by both, satisfies actualist and possibilist `F1cw` and
  `NoEmpty`, but fails `Princ` and `Ax2a`.
* `possibilist_gap`: possibilist `F1cw` and `Ax2a` with a non-actual generator: no `Princ`. -/

namespace Programme.«20261022-0733-ontological».Run2.F1Bridge

open Programme.«20261022-0733-ontological».Run2 Programme.«20261022-0733-ontological».Run2.TwoClosed Programme.«20261022-0733-ontological».Run2.Principal
variable {W E : Type}

/-! Verbatim copies of the library definitions (`Countermodels/Tests.lean` `Model`,
`Countermodels/Scott.lean` `guard`, `Atlas/FilterAxis.lean` `NoEmpty`,
`Atlas/PrincipalAxis.lean` `F1cw`): the library's `Programme.«20261021-1639-ontological»`
modules are not importable from this package (same root name `Programme`). -/
namespace Tests
structure Model (W E : Type) where
  rel : W → W → Prop
  actual : E → W → Prop
  positive : (E → W → Prop) → W → Prop
end Tests

def guard (m : Tests.Model W E) (actualist : Bool) (x : E) (w : W) : Prop :=
  actualist = true → m.actual x w
def NoEmpty (m : Tests.Model W E) : Prop := ∀ w, ¬ m.positive (fun _ _ => False) w
/-- F1, current-world reading: P(w) is generated by g w under guarded inclusion at w. -/
def F1cw (m : Tests.Model W E) (a : Bool) : Prop := ∀ w, ∃ g : E → W → Prop, ∀ p,
  m.positive p w ↔ ∀ x, guard m a x w → g x w → p x w

/-- A library model read with every carrier full. -/
def full (m : Tests.Model W E) : TwoClosed.Model W E :=
  ⟨m.rel, m.actual, fun _ => True, fun _ => True, fun _ => True, m.positive⟩

theorem F1cw_of_princ (m : Tests.Model W E) (a : Bool) (h : ∀ w, Princ (full m) w) :
    F1cw m a := by
  intro w
  obtain ⟨g, hg, hp⟩ := h w
  refine ⟨fun x _ => x = g, fun p => ⟨fun pp x _ e => e ▸ (hp p trivial).1 pp, fun k => ?_⟩⟩
  exact (hp p trivial).2 (k g (fun _ => hg) rfl)

theorem princ_of_F1cw (m : Tests.Model W E) (h : F1cw m true) (h2a : Ax2a (full m)) :
    ∀ w, Princ (full m) w := by
  intro w
  obtain ⟨g, hg⟩ := h w
  have pt : m.positive (top) w := (hg _).2 fun _ _ _ => trivial
  have nt : ¬ m.positive (neg top) w := fun pn => (h2a top trivial w).2 ⟨pt, pn⟩
  have ne : ∃ x, m.actual x w ∧ g x w := by
    apply Classical.byContradiction; intro hn
    exact nt ((hg _).2 fun x hx hgx _ => hn ⟨x, hx rfl, hgx⟩)
  obtain ⟨x0, hx0, hg0⟩ := ne
  have uniq : ∀ y, m.actual y w → g y w → y = x0 := by
    intro y hy hgy
    rcases (h2a (fun z _ => z = x0) trivial w).1 with p | p
    · exact (hg _).1 p y (fun _ => hy) hgy
    · exact absurd rfl ((hg _).1 p x0 (fun _ => hx0) hg0)
  refine ⟨x0, hx0, fun φ _ => ⟨fun pφ => (hg φ).1 pφ x0 (fun _ => hx0) hg0, fun hφ => ?_⟩⟩
  exact (hg φ).2 fun y hy hgy => uniq y (hy rfl) hgy ▸ hφ

/-- Possibilist guard: still a single generator, but it need not be actual. -/
theorem princ_of_F1cw_poss (m : Tests.Model W E) (h : F1cw m false) (h2a : Ax2a (full m)) :
    ∀ w, ∃ g, ∀ φ, m.positive φ w ↔ φ g w := by
  intro w
  obtain ⟨g, hg⟩ := h w
  have pt : m.positive (top) w := (hg _).2 fun _ _ _ => trivial
  have nt : ¬ m.positive (neg top) w := fun pn => (h2a top trivial w).2 ⟨pt, pn⟩
  have ne : ∃ x, g x w := by
    apply Classical.byContradiction; intro hn
    exact nt ((hg _).2 fun x _ hgx _ => hn ⟨x, hgx⟩)
  obtain ⟨x0, hg0⟩ := ne
  have uniq : ∀ y, g y w → y = x0 := by
    intro y hgy
    rcases (h2a (fun z _ => z = x0) trivial w).1 with p | p
    · exact (hg _).1 p y (fun e => Bool.noConfusion e) hgy
    · exact absurd rfl ((hg _).1 p x0 (fun e => Bool.noConfusion e) hg0)
  refine ⟨x0, fun φ => ⟨fun pφ => (hg φ).1 pφ x0 (fun e => Bool.noConfusion e) hg0, fun hφ => ?_⟩⟩
  exact (hg φ).2 fun y _ hgy => uniq y hgy ▸ hφ

/-- One world, two actual entities, positive = shared by both. -/
def both : Tests.Model Unit Bool :=
  ⟨fun _ _ => True, fun _ _ => True, fun p w => p true w ∧ p false w⟩

theorem not_princ_of_F1cw :
    F1cw both true ∧ F1cw both false ∧ NoEmpty both ∧ ¬ Ax2a (full both) ∧
      ∀ w : Unit, ¬ Princ (full both) w := by
  have f : ∀ a, F1cw both a := fun a w =>
    ⟨fun _ _ => True, fun p => ⟨fun ⟨h1, h2⟩ x _ _ => by cases x <;> assumption,
      fun k => ⟨k true (fun _ => trivial) trivial, k false (fun _ => trivial) trivial⟩⟩⟩
  refine ⟨f true, f false, fun _ h => h.1, fun h => ?_, fun w ⟨g, _, hp⟩ => ?_⟩
  · rcases (h (fun z _ => z = true) trivial ()).1 with ⟨_, h2⟩ | ⟨h1, _⟩
    · exact Bool.noConfusion h2
    · exact h1 rfl
  · have := (hp (fun z _ => z = g) trivial).2 rfl
    cases g
    · exact Bool.noConfusion this.1
    · exact Bool.noConfusion this.2

/-- Possibilist F1cw with a non-actual generator: Ax2a holds, Princ fails everywhere. -/
def ghost : Tests.Model Unit Bool :=
  ⟨fun _ _ => True, fun x _ => x = true, fun p w => p false w⟩

theorem possibilist_gap :
    F1cw ghost false ∧ Ax2a (full ghost) ∧ ¬ F1cw ghost true ∧ ∀ w : Unit, ¬ Princ (full ghost) w := by
  refine ⟨fun w => ⟨fun x _ => x = false, fun p => ⟨fun hp x _ e => e ▸ hp,
      fun k => k false (fun e => Bool.noConfusion e) rfl⟩⟩,
    fun φ _ w => ⟨by by_cases h : φ false w
                     · exact Or.inl h
                     · exact Or.inr h, fun ⟨h1, h2⟩ => h2 h1⟩, fun h => ?_, ?_⟩
  · obtain ⟨g, hg⟩ := h ()
    by_cases gt : g true ()
    · exact Bool.noConfusion ((hg (fun z _ => z = false)).1 rfl true (fun _ => rfl) gt)
    · exact (hg (fun _ _ => False)).2 fun x hx hgx => gt (hx rfl ▸ hgx)
  · intro w ⟨g, hg, hp⟩
    have hg' : g = true := hg
    subst hg'
    exact Bool.noConfusion ((hp (fun z _ => z = true) trivial).2 rfl)

/-- **Bridge.** Under `Ax2a` on full carriers, the library's actualist `F1cw` is exactly
K38's `Princ` at every world. -/
theorem F1cw_iff_princ (m : Tests.Model W E) (h2a : Ax2a (full m)) :
    F1cw m true ↔ ∀ w, Princ (full m) w :=
  ⟨fun h => princ_of_F1cw m h h2a, F1cw_of_princ m true⟩

#print axioms F1cw_iff_princ
#print axioms F1cw_of_princ
#print axioms princ_of_F1cw
#print axioms princ_of_F1cw_poss
#print axioms not_princ_of_F1cw
#print axioms possibilist_gap

end Programme.«20261022-0733-ontological».Run2.F1Bridge
